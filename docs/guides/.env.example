# Copy to .env.local for local setup. Never commit real values.
# preview = synthetic accounts; supabase = real account integration, never synthetic fallback.
NORVI_MODE=preview
APP_ORIGIN=http://127.0.0.1:4321
SUPABASE_URL=
SUPABASE_ANON_KEY=
