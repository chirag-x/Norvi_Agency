---
import App from '../ui/App';
import '../styles/global.css';
import { routes } from '../../../../packages/shared/model';
import catalog from '../../../../packages/shared/catalog.json';

export function getStaticPaths() {
  const fixed = routes.filter(p=>!p.startsWith('checkout/'));
  // Ensure we use slugs for agents, not IDs
  const staticRoutes = fixed.map(p => {
    if (p.startsWith('agents/')) {
      const id = p.split('/')[1];
      const product = catalog.products.find(prod => prod.id === id);
      if (product) return `agents/${product.slug}`;
    }
    return p;
  });
  
  return staticRoutes.map(path => ({ params: { path: path || undefined } }));
}

const path = '/' + (Astro.params.path || '');
const privatePage = /\/(account|admin|checkout|orders|login|register)/.test(path);
const settings = catalog.settings;

let title = path === "/" ? "NORVI | Autonomous AI Agents & Tech Agency" : settings.name + " - AI agents for your everyday work";
let description = settings.description;
let ogImage = "https://nor-vi.in/logo.jpg?v=2";
let keywords = "NORVI, NORVI AI, NORVI Agency, NORVI AI Agency, NORVI Agents, NORVI AI Agents, Autonomous AI Agents, AI Automation, Rolvio, Voro, Omnix, AI Job Search, Tech Agency";
let isProduct = false;
let productJsonLd = "";
let faqJsonLd = "";
let breadcrumbJsonLd = "";

if (path.startsWith('/agents/')) {
  const slug = path.split('/')[2];
  const product = catalog.products.find(p => p.slug === slug);
  if (product) {
    isProduct = true;
    const ext = (product as any).extendedContent || {};
    const seo = ext.seo || {};

    title = seo.metaTitle || `${product.name} - ${product.tagline} | ${settings.name}`;
    description = seo.metaDescription || product.description;

    if (seo.ogImage) {
      ogImage = seo.ogImage;
    } else if (ext.heroMediaUrl && !/\.(mp4|webm)$/i.test(ext.heroMediaUrl)) {
      ogImage = ext.heroMediaUrl;
    }

    if (seo.focusKeywords) {
      keywords = `${seo.focusKeywords}, NORVI, NORVI AI, AI Agents, Autonomous Agents, ${product.name}`;
    } else {
      keywords = `${product.name}, ${product.name} AI, ${product.category?.name || 'automation'}, NORVI, NORVI AI, Autonomous AI Agents, AI Copilot`;
    }

    const priceMatch = (product.price || '').replace(/,/g, '').match(/\d+(\.\d+)?/);
    const priceVal = priceMatch ? priceMatch[0] : '499';

    productJsonLd = JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": product.name,
      "headline": product.tagline,
      "description": description,
      "applicationCategory": "BusinessApplication",
      "operatingSystem": product.requirements || "Windows 10, Windows 11, macOS, Linux",
      "offers": {
        "@type": "Offer",
        "price": priceVal,
        "priceCurrency": "INR",
        "availability": product.releaseStatus === 'live' ? "https://schema.org/InStock" : "https://schema.org/PreOrder"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "reviewCount": "128",
        "bestRating": "5",
        "worstRating": "1"
      }
    });

    if (ext.faqs && ext.faqs.length > 0) {
      faqJsonLd = JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": ext.faqs.map((faq: any) => ({
          "@type": "Question",
          "name": faq.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": faq.answer
          }
        }))
      });
    }

    breadcrumbJsonLd = JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://nor-vi.in"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "AI Agents",
          "item": "https://nor-vi.in/agents"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": product.name,
          "item": `https://nor-vi.in/agents/${product.slug}`
        }
      ]
    });
  }
} else if (path === '/agents') {
  title = "All AI Agents | " + settings.name;
} else if (path === '/contact') {
  title = "Contact Us | " + settings.name;
}

const websiteJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "NORVI Agency",
  "alternateName": ["NORVI", "NORVI AI Agency", "NORVI AI"],
  "url": "https://nor-vi.in/"
});

const orgJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "NORVI Agency",
  "alternateName": ["NORVI", "NORVI AI", "NORVI AI Agency", "NORVI Agents"],
  "url": "https://nor-vi.in",
  "logo": "https://nor-vi.in/logo.jpg?v=2",
  "description": settings.description,
  "sameAs": []
});
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
  
  <title>{title}</title>
  <meta name="description" content={description}/>
  <meta name="keywords" content={keywords} />
  <link rel="canonical" href={"https://nor-vi.in" + (path === '/' ? '' : path)} />
  <meta name="theme-color" content="#c8ff64" />
  
  <meta property="og:site_name" content="NORVI Agency" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:type" content={isProduct ? "product" : "website"} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  
  <meta name="robots" content={privatePage ? 'noindex,nofollow' : 'index,follow'}/>
  <meta name="google-site-verification" content="CGX36wKy06XEm7c6O0Uq5TG7JzOFqSLGZKA4maz4xMI" />
  {!privatePage && <><script type="application/ld+json" set:html={websiteJsonLd}></script>
  <script type="application/ld+json" set:html={orgJsonLd}></script></>}
  {isProduct && productJsonLd && <script type="application/ld+json" set:html={productJsonLd}></script>}
  {isProduct && faqJsonLd && <script type="application/ld+json" set:html={faqJsonLd}></script>}
  {isProduct && breadcrumbJsonLd && <script type="application/ld+json" set:html={breadcrumbJsonLd}></script>}

  <!-- Meta Pixel Code (Strict Affirmative Consent Guarded) -->
  <script is:inline>
    (function() {
      try {
        if (typeof window !== 'undefined' && window.localStorage && window.localStorage.getItem('norvi_advertising_consent') === 'granted') {
          !function(f,b,e,v,n,t,s)
          {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
          n.callMethod.apply(n,arguments):n.queue.push(arguments)};
          if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
          n.queue=[];t=b.createElement(e);t.async=!0;
          t.src=v;s=b.getElementsByTagName(e)[0];
          s.parentNode.insertBefore(t,s)}(window, document,'script',
          'https://connect.facebook.net/en_US/fbevents.js');
          fbq('init', '2298637780982908');
          window._norvi_pixel_initialized = true;
          fbq('track', 'PageView');
        }
      } catch (e) {}
    })();
  </script>
  <!-- End Meta Pixel Code -->
</head>
<body>
  <!-- Netlify Form Detection for SPA Pre-rendering -->
  <form name="contact" method="POST" data-netlify="true" hidden style="display:none;">
    <input type="hidden" name="form-name" value="contact" />
    <input type="text" name="name" />
    <input type="email" name="email" />
    <textarea name="message"></textarea>
  </form>
  <form name="support" method="POST" data-netlify="true" hidden style="display:none;">
    <input type="hidden" name="form-name" value="support" />
    <input type="text" name="name" />
    <input type="email" name="email" />
    <input type="text" name="subject" />
    <textarea name="message"></textarea>
  </form>
  <App initialPath={path} client:load />
  <noscript>This website needs JavaScript for accounts and checkout. Enable it to continue.</noscript>
</body>
</html>