---
import App from '../ui/App';
import '../styles/global.css';
import { routes } from '../../../../packages/shared/model';
import catalog from '../../../../packages/shared/catalog.json';

export function getStaticPaths() {
  const nonAgentFixed = routes.filter(p => !p.startsWith('checkout/') && !p.startsWith('agents/'));
  const productRoutes = (catalog.products || [])
    .filter(prod => prod && prod.slug && (prod.status === 'published' || prod.status === 'archived'))
    .map(prod => `agents/${prod.slug}`);
  const staticRoutes = Array.from(new Set([...nonAgentFixed, ...productRoutes]));
  return staticRoutes.map(path => ({ params: { path: path || undefined } }));
}

const path = '/' + (Astro.params.path || '');
const privatePage = /\/(account|admin|checkout|orders|login|register)/.test(path);
const settings = catalog.settings;
const canonicalPath = path === '/' ? '/' : path.replace(/\/+$/, '') + '/';
const canonicalUrl = `https://nor-vi.in${canonicalPath}`;

let title = path === "/" ? "NORVI Agency | Autonomous AI Agents" : "NORVI Agency - AI agents for your everyday work";
let description = settings.description;
let ogImage = "https://nor-vi.in/logo.jpg?v=2";
let keywords = "NORVI, NORVI AI, NORVI Agency, NORVI AI Agency, NORVI Agents, NORVI AI Agents, Autonomous AI Agents, AI Automation, Rolvio, Voro, Omnix, AI Job Search, Tech Agency";
let isProduct = false;
let productJsonLd = "";
let faqJsonLd = "";
let breadcrumbJsonLd = "";

if (path.startsWith('/agents/')) {
  const slug = path.split('/')[2];
  const product = catalog.products.find(p => p.slug === slug);
  if (product) {
    isProduct = true;
    const ext = (product as any).extendedContent || {};
    const seo = ext.seo || {};

    title = seo.metaTitle || `${product.name} - ${product.tagline} | NORVI Agency`;
    description = seo.metaDescription || product.description;

    if (seo.ogImage) {
      ogImage = seo.ogImage;
    } else if (ext.heroMediaUrl && !/\.(mp4|webm)$/i.test(ext.heroMediaUrl)) {
      ogImage = ext.heroMediaUrl;
    }

    if (seo.focusKeywords) {
      keywords = `${seo.focusKeywords}, NORVI, NORVI AI, AI Agents, Autonomous Agents, ${product.name}`;
    } else {
      keywords = `${product.name}, ${product.name} AI, ${product.category?.name || 'automation'}, NORVI, NORVI AI, Autonomous AI Agents, AI Copilot`;
    }

    const priceMatch = (product.price || '').replace(/,/g, '').match(/\d+(\.\d+)?/);
    const priceVal = priceMatch ? priceMatch[0] : ((product as any).price1m ? String((product as any).price1m) : '499');

    productJsonLd = JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": product.name,
      "headline": product.tagline,
      "description": description,
      "applicationCategory": "BusinessApplication",
      "operatingSystem": product.requirements || "Windows 10, Windows 11, macOS, Linux",
      "offers": {
        "@type": "Offer",
        "price": priceVal,
        "priceCurrency": "INR",
        "availability": product.releaseStatus === 'live' ? "https://schema.org/InStock" : "https://schema.org/PreOrder"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "reviewCount": "128",
        "bestRating": "5",
        "worstRating": "1"
      }
    });

    if (ext.faqs && ext.faqs.length > 0) {
      faqJsonLd = JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": ext.faqs.map((faq: any) => ({
          "@type": "Question",
          "name": faq.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": faq.answer
          }
        }))
      });
    }

    breadcrumbJsonLd = JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://nor-vi.in/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "AI Agents",
          "item": "https://nor-vi.in/agents/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": product.name,
          "item": `https://nor-vi.in/agents/${product.slug}/`
        }
      ]
    });
  }
} else if (path === '/agents') {
  title = "All AI Agents | NORVI Agency";
} else if (path === '/about') {
  title = "About NORVI Agency & Founder Chirag Sharma";
  description = "Learn about NORVI Agency and founder Chirag Sharma. Discover how our autonomous, privacy-first desktop AI agents simplify everyday workflows.";
  keywords = "Chirag Sharma, Chirag Sharma NORVI, Founder of NORVI Agency, NORVI Agency Owner, NORVI AI, Autonomous Desktop Agents, AI Engineer India";
} else if (path === '/partners') {
  title = "Partner Program | NORVI Agency";
} else if (path === '/help') {
  title = "Help Center | NORVI Agency";
} else if (path === '/contact') {
  title = "Contact Us | NORVI Agency";
}

const websiteJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "NORVI Agency",
  "alternateName": ["NORVI", "NORVI AI Agency", "NORVI AI"],
  "url": "https://nor-vi.in/"
});

const founderJsonLd = {
  "@type": "Person",
  "name": "Chirag Sharma",
  "jobTitle": "Founder & Lead AI Engineer",
  "url": "https://chirag-portfolio-v3.netlify.app/",
  "sameAs": [
    "https://chirag-portfolio-v3.netlify.app/",
    (settings as any).socialInstagram,
    (settings as any).socialYoutube,
    (settings as any).socialFacebook,
    (settings as any).socialTwitter
  ].filter(Boolean),
  "knowsAbout": [
    "Autonomous AI Agents",
    "Desktop Software Engineering",
    "Multimodal Computer Vision",
    "Audio DSP & Hardware Routing",
    "Career & Media Automation"
  ],
  "nationality": {
    "@type": "Country",
    "name": "India"
  },
  "worksFor": {
    "@type": "Organization",
    "name": "NORVI Agency",
    "url": "https://nor-vi.in/"
  }
};

const orgJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "NORVI Agency",
  "alternateName": ["NORVI", "NORVI AI", "NORVI AI Agency", "NORVI Agents"],
  "url": "https://nor-vi.in/",
  "logo": "https://nor-vi.in/logo.jpg?v=2",
  "description": settings.description,
  "founder": founderJsonLd,
  "sameAs": [
    (settings as any).socialInstagram,
    (settings as any).socialYoutube,
    (settings as any).socialFacebook,
    (settings as any).socialTwitter,
    "https://chirag-portfolio-v3.netlify.app/"
  ].filter(Boolean)
});

const aboutPageJsonLd = path === '/about' ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "About NORVI Agency & Founder Chirag Sharma",
  "url": "https://nor-vi.in/about/",
  "description": "Learn about NORVI Agency and founder Chirag Sharma. Discover our autonomous, privacy-first desktop AI agents.",
  "mainEntity": founderJsonLd
}) : "";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
  
  <title>{title}</title>
  <meta name="description" content={description}/>
  <meta name="keywords" content={keywords} />
  <link rel="canonical" href={canonicalUrl} />
  <meta name="theme-color" content="#111411" />
  <meta name="color-scheme" content="dark" />
  
  <meta property="og:site_name" content="NORVI Agency" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:type" content={isProduct ? "product" : "website"} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  
  <meta name="robots" content={privatePage ? 'noindex,nofollow' : 'index,follow'}/>
  <meta name="google-site-verification" content="CGX36wKy06XEm7c6O0Uq5TG7JzOFqSLGZKA4maz4xMI" />
  {path === '/' && <script type="application/ld+json" set:html={websiteJsonLd}></script>}
  {!privatePage && <script type="application/ld+json" set:html={orgJsonLd}></script>}
  {isProduct && productJsonLd && <script type="application/ld+json" set:html={productJsonLd}></script>}
  {isProduct && faqJsonLd && <script type="application/ld+json" set:html={faqJsonLd}></script>}
  {isProduct && breadcrumbJsonLd && <script type="application/ld+json" set:html={breadcrumbJsonLd}></script>}
  {path === '/about' && aboutPageJsonLd && <script type="application/ld+json" set:html={aboutPageJsonLd}></script>}

  <!-- Meta Pixel Code (Strict Affirmative Consent Guarded) -->
  <script is:inline>
    (function() {
      try {
        if (typeof window !== 'undefined' && window.localStorage && window.localStorage.getItem('norvi_advertising_consent') === 'granted') {
          !function(f,b,e,v,n,t,s)
          {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
          n.callMethod.apply(n,arguments):n.queue.push(arguments)};
          if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
          n.queue=[];t=b.createElement(e);t.async=!0;
          t.src=v;s=b.getElementsByTagName(e)[0];
          s.parentNode.insertBefore(t,s)}(window, document,'script',
          'https://connect.facebook.net/en_US/fbevents.js');
          fbq('init', '2298637780982908');
          window._norvi_pixel_initialized = true;
          fbq('track', 'PageView');
        }
      } catch (e) {}
    })();
  </script>
  <!-- End Meta Pixel Code -->
</head>
<body>
  <!-- Netlify Form Detection for SPA Pre-rendering -->
  <form name="contact" method="POST" data-netlify="true" hidden style="display:none;">
    <input type="hidden" name="form-name" value="contact" />
    <input type="text" name="name" />
    <input type="email" name="email" />
    <textarea name="message"></textarea>
  </form>
  <form name="support" method="POST" data-netlify="true" hidden style="display:none;">
    <input type="hidden" name="form-name" value="support" />
    <input type="text" name="name" />
    <input type="email" name="email" />
    <input type="text" name="subject" />
    <textarea name="message"></textarea>
  </form>
  <App initialPath={path} client:load />
  <noscript>This website needs JavaScript for accounts and checkout. Enable it to continue.</noscript>
</body>
</html>